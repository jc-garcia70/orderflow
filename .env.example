# OrderFlow Infrastructure - Environment Configuration
# Copy this file to .env to override defaults

# PostgreSQL
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_secret
POSTGRES_PORT=5432

# Kafka & Kafka UI
KAFKA_PORT=9092
KAFKA_UI_PORT=8085

# Redis
REDIS_PORT=6379

# Zipkin
ZIPKIN_PORT=9411

# Eureka Server
EUREKA_PORT=8761
